# =============================================================================
# LLM RAG Performance Analytics — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to git! It contains secrets.
# =============================================================================

# --- OpenAI (GPT-4o-mini) ---
# Get your key at: https://platform.openai.com/api-keys
# Cost: ~$0.15/1M input tokens — full experiment costs ~$1-3
OPENAI_API_KEY=sk-your-openai-key-here

# --- Google Gemini (Free tier) ---
# Get your key at: https://aistudio.google.com/apikey
# Cost: FREE (rate-limited: 15 RPM)
GOOGLE_API_KEY=your-google-api-key-here

# --- Mistral AI (Free tier) ---
# Get your key at: https://console.mistral.ai/api-keys
# Cost: FREE (rate-limited)
MISTRAL_API_KEY=your-mistral-api-key-here

# --- Qdrant (Vector Database) ---
# Default values for Docker Compose setup — no changes needed for local dev
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Ollama (Local LLMs) ---
# Default values for Docker Compose setup — no changes needed for local dev
OLLAMA_HOST=http://localhost:11434

# --- Application Settings ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Default embedding model for sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
